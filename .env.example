# CopySahaayak environment — copy to .env and fill in. NEVER commit real values.

# Postgres (Supabase or Neon). Runtime should use a POOLED url (pgbouncer),
# DIRECT_URL (unpooled) is used by the Prisma CLI for schema push/migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?schema=public&pgbouncer=true&connection_limit=10&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"

# 64-hex random secret for HMAC-signed file URLs (openssl rand -hex 32)
APP_SECRET=""

# File storage backend: "database" (default, bytes in Postgres) or "supabase"
STORAGE_DRIVER="database"

# Supabase (optional — enables free-tier email OTP for password reset).
# Create at supabase.com → Project Settings → API
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="csp-documents"
