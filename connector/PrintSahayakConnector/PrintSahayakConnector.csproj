<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building/publishing a windows-targeting project from Linux CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PrintSahayakConnector</AssemblyName>
    <RootNamespace>PrintSahayakConnector</RootNamespace>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <InformationalVersion>1.7.0</InformationalVersion>
    <Company>PrintSahayak Platforms</Company>
    <Product>Desktop Sahaayak</Product>
    <Description>Tray application that connects shop printers to the Desktop Sahaayak print automation SaaS.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
